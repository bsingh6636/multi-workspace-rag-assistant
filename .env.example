# Copy the server block to server/.env and the client block to client/.env.
# In production, pass the same values to the container as environment variables (VITE_* are needed at build time).

# ---------- server/.env (server only, never sent to the browser) ----------
PORT=3000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
# Models tested on the free tier (2026-11-18). The 3.8-flash and 4-hydrogen models returned 503 (overloaded),
# and 2.5-flash returned 404 for new users, so don't use them.
GEMINI_CHAT_MODEL=gemini-3.6-flash
# Used after retries on GEMINI_CHAT_MODEL fail with 429/503.
GEMINI_CHAT_FALLBACK_MODEL=gemini-3.5-flash-lite
# Called with outputDimensionality 768 (matches vector(768) in sql/schema.sql).
GEMINI_EMBED_MODEL=gemini-embedding-001
# Per-minute free-tier quota of the embedding model (see aistudio.google.com/rate-limit).
# One upload may use at most 95% of it; bigger files are rejected with a clear error.
GEMINI_EMBED_RPM=100
GEMINI_EMBED_TPM=30000
# Optional: only needed for the send_discord_summary tool.
DISCORD_WEBHOOK_URL=
SIMILARITY_THRESHOLD=0.62
MAX_TOOL_ITERATIONS=3

# ---------- client/.env (public values only) ----------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
