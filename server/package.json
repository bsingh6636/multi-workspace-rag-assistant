{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "description": "Express API for the multi-workspace assistant",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "test": "tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@google/genai": "^3.4.0",
    "@supabase/supabase-js": "^2.119.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "pdf-parse": "^2.4.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
